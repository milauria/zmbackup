#!/bin/bash

# Exit on error
set -e

# Usage message
usage() {
    echo "Usage: $0 {init|release|test|behave|format}"
    echo "  init:    Create virtual environment and install requirements"
    echo "  release: Run tests and then lints"
    echo "  test:    Run unit tests"
    echo "  behave:  Run functional tests"
    echo "  format:  Run lints/formatting"
    exit 1
}

# Check if a parameter is provided
if [ $# -lt 1 ]; then
    usage
fi

COMMAND=$1

case "$COMMAND" in
    init)
        echo "Initializing virtual environment..."
        if [ -d ".venv" ]; then
            echo ".venv already exists. Skipping creation."
        else
            python3 -m venv .venv
        fi
        # Activate and install
        . .venv/bin/activate
        pip install -r requirements.txt
        echo "Initialization complete."
        ;;
    test)
        echo "Running unit tests..."
        . .venv/bin/activate
        shift
        if [ $# -eq 0 ]; then
            PYTHONPATH=./src pytest tests
        else
            PYTHONPATH=./src pytest "$@"
        fi
        ;;
    behave)
        echo "Running functional tests..."
        . .venv/bin/activate
        shift
        if [ $# -eq 0 ]; then
            PYTHONPATH=./src behave test_func/features/
        else
            PYTHONPATH=./src behave "$@"
        fi
        ;;
    format)
        echo "Running formatting and linting..."
        . .venv/bin/activate
        black src tests && isort src tests && mypy src tests --explicit-package-bases
        ;;
    release)
        echo "Starting release process (test -> behave -> lint)..."
        # Run tests
        echo "Step 1: Running unit tests..."
        . .venv/bin/activate
        PYTHONPATH=./src pytest tests
        
        # Run functional tests
        echo "Step 2: Running functional tests..."
        PYTHONPATH=./src behave test_func/features/

        # Run lints
        echo "Step 3: Running formatting and linting..."
        black src tests && isort src tests && mypy src tests --explicit-package-bases
        echo "Release checks passed."
        ;;
    *)
        usage
        ;;
esac
